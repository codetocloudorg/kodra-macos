        echo "    kodra dev           Set up language runtimes (via mise)"
        echo "    kodra extensions    Manage VS Code extensions"
        echo "    kodra shortcuts     Show aliases and shortcuts"
        echo ""
        echo "  Info"
        echo "    kodra fetch         Show system info (fastfetch)"
        echo "    kodra menu          Interactive TUI menu"
        echo "    kodra welcome       Show welcome screen"
        echo "    kodra version       Show version"
        echo "    kodra help          Show this help"
        echo ""
        echo "  Tips:"
        echo "    Run kodra menu for guided, interactive usage"
        echo "    Run kodra doctor after install to verify everything"
        echo "    Run kodra update to keep all tools current"
        echo "    Run kodra repair --all to fix any issues"
        echo ""
        return
    fi

    echo ""
    echo -e "${C_DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "${C_LOGO_1}  ██╗  ██╗ ██████╗ ██████╗ ██████╗  █████╗${C_RESET}"
    echo -e "${C_LOGO_2}  ██║ ██╔╝██╔═══██╗██╔══██╗██╔══██╗██╔══██╗${C_RESET}"
    echo -e "${C_LOGO_3}  █████╔╝ ██║   ██║██║  ██║██████╔╝███████║${C_RESET}"
    echo -e "${C_LOGO_4}  ██╔═██╗ ██║   ██║██║  ██║██╔══██╗██╔══██║${C_RESET}"
    echo -e "${C_LOGO_5}  ██║  ██╗╚██████╔╝██████╔╝██║  ██║██║  ██║${C_RESET}"
    echo -e "${C_LOGO_5}  ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝${C_RESET}"
    echo ""
    echo -e "  ${C_BOLD}v${ver}${C_RESET} ${C_DIM}•${C_RESET} macOS Edition ${C_DIM}•${C_RESET} by Code To Cloud"
