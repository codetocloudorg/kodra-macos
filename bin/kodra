        echo "  ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝"
        echo ""
        echo "  v${ver} • macOS Edition • by Code To Cloud"
        echo "  kodra.macos.codetocloud.io"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "  Usage: kodra <command> [options]"
        echo ""
        echo "  System"
        echo "    doctor              Check system health and tool status"
