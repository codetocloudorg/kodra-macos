    echo -e "    ${C_LOGO_5}kodra repair --all${C_RESET}  Repair everything automatically"
    echo ""
    echo -e "  ${C_BOLD}Configuration${C_RESET}"
    echo -e "    ${C_LOGO_5}kodra setup${C_RESET}         Re-run first-time configuration"
    echo -e "    ${C_LOGO_5}kodra cleanup${C_RESET}       Clean brew cache, Docker images, logs"
    echo -e "    ${C_LOGO_5}kodra refresh${C_RESET}       Refresh shell configs"
    echo -e "    ${C_LOGO_5}kodra defaults${C_RESET}      Re-apply macOS system defaults"
    echo ""
    echo -e "  ${C_BOLD}Package Management${C_RESET}"
    echo -e "    ${C_LOGO_5}kodra install${C_RESET}       Install tools (interactive menu)"
    echo -e "    ${C_LOGO_5}kodra uninstall${C_RESET}     Remove a specific tool"
    echo ""
    echo -e "  ${C_BOLD}Backup & Recovery${C_RESET}"
    echo -e "    ${C_LOGO_5}kodra backup${C_RESET}        Create a dotfiles backup"
    echo -e "    ${C_LOGO_5}kodra backup list${C_RESET}   List available backups"
    echo -e "    ${C_LOGO_5}kodra backup restore <name>${C_RESET}  Restore from backup"
    echo -e "    ${C_LOGO_5}kodra restore${C_RESET}       Restore from a backup"
    echo -e "    ${C_LOGO_5}kodra migrate${C_RESET}       Run version migrations"
