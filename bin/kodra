#!/usr/bin/env bash
#
# Kodra macOS CLI
# Main command interface
#

KODRA_DIR="${KODRA_DIR:-$HOME/.kodra}"
KODRA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kodra"

# Colors
C_RESET='\033[0m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_BLUE='\033[0;34m'
C_CYAN='\033[0;36m'
C_WHITE='\033[1;37m'
C_GRAY='\033[0;90m'
C_PURPLE='\033[38;5;135m'

show_version() {
    if [[ -f "$KODRA_DIR/VERSION" ]]; then
        cat "$KODRA_DIR/VERSION"
    else
        echo "unknown"
    fi
}

