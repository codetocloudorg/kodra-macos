        echo "    dev                 Set up language runtimes (via mise)"
        echo "    extensions          Manage VS Code extensions"
        echo "    shortcuts           Show aliases and shortcuts"
        echo "    db                  Inspect Kodra state database"
        echo "    ci                  Show CI pipeline status"
        echo ""
        echo "  Info"
        echo "    fetch               Show system info (fastfetch)"
        echo "    banner              Show ASCII logo and system info"
        echo "    menu                Interactive TUI menu"
        echo "    welcome             Show welcome screen"
        echo "    version             Show version"
        echo "    help                Show this help"
        echo ""
        echo "  Tips:"
        echo "    Run kodra menu for guided, interactive usage"
        echo "    Run kodra doctor after install to verify everything"
        echo "    Run kodra update to keep all tools current"
        echo "    Run kodra repair --all to fix any issues"
        echo ""
        return
    fi

    echo ""
    echo -e "${C_DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""
    echo -e "    ${C_LOGO_1}██╗  ██╗${C_LOGO_2} ██████╗ ${C_LOGO_3}██████╗ ${C_LOGO_4}██████╗ ${C_LOGO_5} █████╗${C_RESET}"
    echo -e "    ${C_LOGO_1}██║ ██╔╝${C_LOGO_2}██╔═══██╗${C_LOGO_3}██╔══██╗${C_LOGO_4}██╔══██╗${C_LOGO_5}██╔══██╗${C_RESET}"
    echo -e "    ${C_LOGO_1}█████╔╝ ${C_LOGO_2}██║   ██║${C_LOGO_3}██║  ██║${C_LOGO_4}██████╔╝${C_LOGO_5}███████║${C_RESET}"
    echo -e "    ${C_LOGO_1}██╔═██╗ ${C_LOGO_2}██║   ██║${C_LOGO_3}██║  ██║${C_LOGO_4}██╔══██╗${C_LOGO_5}██╔══██║${C_RESET}"
    echo -e "    ${C_LOGO_1}██║  ██╗${C_LOGO_2}╚██████╔╝${C_LOGO_3}██████╔╝${C_LOGO_4}██║  ██║${C_LOGO_5}██║  ██║${C_RESET}"
    echo -e "    ${C_LOGO_1}╚═╝  ╚═╝${C_LOGO_2} ╚═════╝ ${C_LOGO_3}╚═════╝ ${C_LOGO_4}╚═╝  ╚═╝${C_LOGO_5}╚═╝  ╚═╝${C_RESET}"
    echo ""
    echo -e "    ${C_BOLD}v${ver}${C_RESET} ${C_DIM}•${C_RESET} macOS Edition ${C_DIM}•${C_RESET} by Code To Cloud"
    echo -e "    ${C_DIM}kodra.macos.codetocloud.io${C_RESET}"
    echo ""
    echo -e "${C_DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""
    echo -e "  ${C_BOLD}Usage:${C_RESET} kodra <command> [options]"
    echo ""
    echo -e "  ${C_LOGO_1}${C_BOLD}System${C_RESET}"
    echo -e "    ${C_BOLD}doctor${C_RESET}              Check system health and tool status"
    echo -e "    ${C_BOLD}doctor --fix${C_RESET}         Auto-reinstall missing tools"
    echo -e "    ${C_BOLD}update${C_RESET}              Update all installed tools (brew upgrade)"
    echo -e "    ${C_BOLD}repair${C_RESET}              Interactive repair menu"
    echo -e "    ${C_BOLD}repair --all${C_RESET}        Repair everything automatically"
    echo -e "    ${C_BOLD}cleanup${C_RESET}             Clean brew cache, Docker images, logs"
    echo -e "    ${C_BOLD}defaults${C_RESET}            Re-apply macOS system defaults"
    echo ""
    echo -e "  ${C_LOGO_2}${C_BOLD}Configuration${C_RESET}"
    echo -e "    ${C_BOLD}setup${C_RESET}               Re-run first-time configuration"
    echo -e "    ${C_BOLD}refresh${C_RESET}             Refresh shell configs"
    echo -e "    ${C_BOLD}install${C_RESET} <tool>      Install tools (interactive menu)"
    echo -e "    ${C_BOLD}uninstall${C_RESET} <tool>    Remove a specific tool"
    echo ""
    echo -e "  ${C_LOGO_3}${C_BOLD}Data${C_RESET}"
    echo -e "    ${C_BOLD}backup${C_RESET}              Back up configs and dotfiles"
    echo -e "    ${C_BOLD}restore${C_RESET}             Restore from a backup"
    echo -e "    ${C_BOLD}resume${C_RESET}              Resume incomplete installation"
    echo -e "    ${C_BOLD}migrate${C_RESET}             Run version migrations"
    echo ""
    echo -e "  ${C_LOGO_4}${C_BOLD}Development${C_RESET}"
    echo -e "    ${C_BOLD}dev${C_RESET}                 Set up language runtimes (via mise)"
    echo -e "    ${C_BOLD}extensions${C_RESET}          Manage VS Code extensions"
    echo -e "    ${C_BOLD}shortcuts${C_RESET}           Show aliases and shortcuts"
    echo -e "    ${C_BOLD}db${C_RESET}                  Inspect Kodra state database"
    echo -e "    ${C_BOLD}ci${C_RESET}                  Show CI pipeline status"
    echo ""
    echo -e "  ${C_LOGO_5}${C_BOLD}Info${C_RESET}"
    echo -e "    ${C_BOLD}fetch${C_RESET}               Show system info (fastfetch)"
    echo -e "    ${C_BOLD}banner${C_RESET}              Show ASCII logo and system info"
    echo -e "    ${C_BOLD}menu${C_RESET}                Interactive TUI menu"
    echo -e "    ${C_BOLD}welcome${C_RESET}             Show welcome screen"
    echo -e "    ${C_BOLD}version${C_RESET}             Show version"
    echo -e "    ${C_BOLD}help${C_RESET}                Show this help"
    echo ""
    echo -e "  ${C_DIM}Tips:${C_RESET}"
    echo -e "  ${C_DIM}  Run kodra menu for guided, interactive usage${C_RESET}"
    echo -e "  ${C_DIM}  Run kodra doctor after install to verify everything${C_RESET}"
    echo -e "  ${C_DIM}  Run kodra update to keep all tools current${C_RESET}"
    echo -e "  ${C_DIM}  Run kodra repair --all to fix any issues${C_RESET}"
    echo ""
}

cmd_doctor() {
    local fix_mode=false
    [[ "$1" == "--fix" ]] && fix_mode=true

    echo ""
    echo -e "  ${C_PURPLE}Kodra macOS Doctor${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""

    local failures=0
    local total=0

    check_tool() {
        local name="$1"
        local cmd="${2:-$1}"
        total=$((total + 1))
        if command -v "$cmd" &>/dev/null; then
            local ver
            ver=$("$cmd" --version 2>/dev/null | head -1 || echo "ok")
            echo -e "  ${C_GREEN}✔${C_RESET} $name ${C_GRAY}($ver)${C_RESET}"
        else
            echo -e "  ${C_RED}✖${C_RESET} $name ${C_GRAY}— not found${C_RESET}"
            failures=$((failures + 1))
            if [[ "$fix_mode" == true ]]; then
                echo -e "    ${C_CYAN}→ Attempting reinstall...${C_RESET}"
                bash "$KODRA_DIR/install/cli-tools/${name}.sh" 2>/dev/null || \
                bash "$KODRA_DIR/install/cloud/${name}.sh" 2>/dev/null || \
                bash "$KODRA_DIR/install/containers/${name}.sh" 2>/dev/null || true
            fi
        fi
    }

    echo -e "  ${C_WHITE}CLI Tools:${C_RESET}"
    check_tool "bat"
    check_tool "btop"
    check_tool "eza"
    check_tool "fastfetch"
    check_tool "fd"
    check_tool "fzf"
    check_tool "gh"
    check_tool "lazygit"
    check_tool "rg" "rg"
    check_tool "yq"
    check_tool "zoxide"

    echo ""
    echo -e "  ${C_WHITE}Cloud Tools:${C_RESET}"
    check_tool "azure-cli" "az"
    check_tool "azd" "azd"
    check_tool "terraform" "terraform"
    check_tool "tofu" "tofu"
    check_tool "kubectl" "kubectl"
    check_tool "helm" "helm"
    check_tool "k9s" "k9s"
    check_tool "powershell" "pwsh"

    echo ""
    echo -e "  ${C_WHITE}Containers:${C_RESET}"
    # Detect container runtime: check state file, fall back to what's installed
    local container_runtime="docker"
    local state_file="${XDG_STATE_HOME:-$HOME/.local/state}/kodra/state.json"
    if [[ -f "$state_file" ]]; then
        local saved_runtime
        saved_runtime="$(python3 -c "
import json
with open('${state_file}', 'r') as f:
    data = json.load(f)
print(data.get('container.runtime', ''))" 2>/dev/null)"
        if [[ -n "$saved_runtime" ]]; then
            container_runtime="$saved_runtime"
        fi
    fi

    if [[ "$container_runtime" == "podman" ]]; then
        check_tool "podman" "podman"
        check_tool "podman-compose" "podman-compose"
    else
        check_tool "colima" "colima"
        check_tool "docker" "docker"
        check_tool "lazydocker" "lazydocker"
    fi

    echo ""
    echo -e "  ${C_WHITE}Terminal:${C_RESET}"
    check_tool "starship" "starship"

    echo ""
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    if [[ "$failures" -eq 0 ]]; then
        echo -e "  ${C_GREEN}✔ All $total tools healthy${C_RESET}"
    else
        echo -e "  ${C_YELLOW}⚠ $failures/$total tools missing${C_RESET}"
        if [[ "$fix_mode" != true ]]; then
            echo -e "  ${C_GRAY}Run: kodra doctor --fix to auto-repair${C_RESET}"
        fi
    fi
    echo ""

    return $failures
}

cmd_update() {
    echo -e "  ${C_CYAN}▶${C_RESET} Updating Homebrew..."
    brew update --quiet

    echo -e "  ${C_CYAN}▶${C_RESET} Upgrading all packages..."
    brew upgrade --quiet

    echo -e "  ${C_CYAN}▶${C_RESET} Updating Kodra..."
    cd "$KODRA_DIR" && git pull --quiet origin main 2>/dev/null || true

    echo -e "  ${C_GREEN}✔${C_RESET} Everything up to date"
}

cmd_cleanup() {
    echo -e "  ${C_CYAN}▶${C_RESET} Cleaning Homebrew cache..."
    brew cleanup --prune=7 -s 2>/dev/null

    echo -e "  ${C_CYAN}▶${C_RESET} Removing old container images..."
    if command -v podman &>/dev/null; then
        podman image prune -f 2>/dev/null || true
    fi
    if command -v docker &>/dev/null; then
        docker image prune -f 2>/dev/null || true
    fi

    echo -e "  ${C_GREEN}✔${C_RESET} Cleanup complete"
}

cmd_fetch() {
    if command -v fastfetch &>/dev/null; then
        fastfetch
    else
        echo "fastfetch not installed — run: kodra doctor --fix"
    fi
}

cmd_defaults() {
    echo -e "  ${C_CYAN}▶${C_RESET} Re-applying macOS defaults..."
    bash "$KODRA_DIR/install/desktop/defaults.sh"
    bash "$KODRA_DIR/install/desktop/dock.sh"
    bash "$KODRA_DIR/install/desktop/finder.sh"
    echo -e "  ${C_GREEN}✔${C_RESET} Defaults applied (some may need logout)"
}

cmd_refresh() {
    echo -e "  ${C_CYAN}▶${C_RESET} Refreshing shell configuration..."
    bash "$KODRA_DIR/install/terminal/shell-config.sh"
    echo -e "  ${C_GREEN}✔${C_RESET} Shell config refreshed — restart terminal or: source ~/.zshrc"
}

cmd_shortcuts() {
    echo ""
    echo -e "  ${C_PURPLE}Kodra macOS Shortcuts${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""
    echo -e "  ${C_WHITE}Git:${C_RESET}       g gs ga gc gp gl gd gb gco gcm"
    echo -e "  ${C_WHITE}Docker:${C_RESET}    d dc dps dlogs"
    echo -e "  ${C_WHITE}K8s:${C_RESET}       k kgp kgs kgd kns"
    echo -e "  ${C_WHITE}Azure:${C_RESET}     azl azs azls"
    echo -e "  ${C_WHITE}Terraform:${C_RESET} tf tfi tfp tfa"
    echo -e "  ${C_WHITE}Files:${C_RESET}     ls→eza ll lt cat→bat grep→rg find→fd cd→z top→btop"
    echo ""
}

cmd_repair() {
    local repair_all=false
    [[ "$1" == "--all" ]] && repair_all=true

    echo ""
    echo -e "  ${C_PURPLE}Kodra macOS Repair${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""

    if [[ "$repair_all" == true ]]; then
        echo -e "  ${C_CYAN}▶${C_RESET} Repairing shell configuration..."
        bash "$KODRA_DIR/install/terminal/shell-config.sh" 2>/dev/null && \
            echo -e "  ${C_GREEN}✔${C_RESET} Shell config repaired" || \
            echo -e "  ${C_RED}✖${C_RESET} Shell config repair failed"

        echo -e "  ${C_CYAN}▶${C_RESET} Repairing Homebrew..."
        brew doctor 2>/dev/null || true

        echo -e "  ${C_CYAN}▶${C_RESET} Re-linking kodra CLI..."
        mkdir -p "$HOME/.local/bin"
        ln -sf "$KODRA_DIR/bin/kodra" "$HOME/.local/bin/kodra"
        echo -e "  ${C_GREEN}✔${C_RESET} CLI re-linked"

        echo -e "  ${C_CYAN}▶${C_RESET} Re-running doctor with auto-fix..."
        cmd_doctor "--fix"
    else
        echo -e "  ${C_WHITE}What would you like to repair?${C_RESET}"
        echo ""
        echo -e "  ${C_CYAN}1)${C_RESET} Shell configuration"
        echo -e "  ${C_CYAN}2)${C_RESET} CLI tools (reinstall missing)"
        echo -e "  ${C_CYAN}3)${C_RESET} Homebrew health"
        echo -e "  ${C_CYAN}4)${C_RESET} Everything"
        echo ""
        printf "  Choose [1-4]: "
        read -n 1 -r choice
        echo ""
        echo ""
        case "$choice" in
            1) bash "$KODRA_DIR/install/terminal/shell-config.sh" ;;
            2) cmd_doctor "--fix" ;;
            3) brew doctor ;;
            4) cmd_repair "--all" ;;
            *) echo -e "  ${C_GRAY}No selection made${C_RESET}" ;;
        esac
    fi
}

cmd_setup() {
    echo ""
    echo -e "  ${C_PURPLE}Kodra macOS Setup${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""

    echo -e "  ${C_WHITE}Configure your accounts:${C_RESET}"
    echo ""

    echo -e "  ${C_CYAN}1)${C_RESET} GitHub (gh auth login)"
    echo -e "  ${C_CYAN}2)${C_RESET} Azure (az login)"
    echo -e "  ${C_CYAN}3)${C_RESET} Git identity (name + email)"
    echo -e "  ${C_CYAN}4)${C_RESET} All of the above"
    echo ""
    printf "  Choose [1-4]: "
    read -n 1 -r choice
    echo ""
    echo ""

    case "$choice" in
        1)
            gh auth login
            ;;
        2)
            az login
            ;;
        3)
            printf "  Git name: "
            read -r git_name
            printf "  Git email: "
            read -r git_email
            git config --global user.name "$git_name"
            git config --global user.email "$git_email"
            echo -e "  ${C_GREEN}✔${C_RESET} Git identity configured"
            ;;
        4)
            printf "  Git name: "
            read -r git_name
            printf "  Git email: "
            read -r git_email
            git config --global user.name "$git_name"
            git config --global user.email "$git_email"
            echo -e "  ${C_GREEN}✔${C_RESET} Git identity configured"
            echo ""
            echo -e "  ${C_CYAN}▶${C_RESET} Opening GitHub login..."
            gh auth login 2>/dev/null || true
            echo ""
            echo -e "  ${C_CYAN}▶${C_RESET} Opening Azure login..."
            az login 2>/dev/null || true
            ;;
        *)
            echo -e "  ${C_GRAY}No selection made${C_RESET}"
            ;;
    esac
}

cmd_extensions() {
    echo -e "  ${C_CYAN}▶${C_RESET} Installing recommended VS Code extensions..."
    bash "$KODRA_DIR/install/dev-tools/vscode.sh"
    echo -e "  ${C_GREEN}✔${C_RESET} Extensions installed"
}

cmd_dev() {
    echo -e "  ${C_CYAN}▶${C_RESET} Setting up language runtimes via mise..."
    bash "$KODRA_DIR/install/dev-tools/mise.sh"
    echo -e "  ${C_GREEN}✔${C_RESET} Runtimes configured"
}

cmd_backup() {
    source "$KODRA_DIR/lib/backup.sh" 2>/dev/null || {
        echo -e "  ${C_RED}✖${C_RESET} Failed to load backup library"
        exit 1
    }

    local subcmd="${1:-create}"
    shift 2>/dev/null || true

    case "$subcmd" in
        create)  create_backup "$@" ;;
        list)    list_backups ;;
        restore) restore_backup "$@" ;;
        delete)  delete_backup "$@" ;;
        verify)  verify_backup "$@" ;;
        *)
            echo -e "  ${C_RED}Unknown backup command:${C_RESET} $subcmd"
            echo -e "  ${C_GRAY}Usage: kodra backup {create|list|restore|delete|verify}${C_RESET}"
            exit 1
            ;;
    esac
}

cmd_restore() {
    source "$KODRA_DIR/lib/backup.sh" 2>/dev/null || {
        echo -e "  ${C_RED}✖${C_RESET} Failed to load backup library"
        exit 1
    }

    if [[ -z "${1:-}" ]]; then
        echo -e "  ${C_YELLOW}Available backups:${C_RESET}"
        list_backups
        echo ""
        echo -e "  ${C_GRAY}Usage: kodra restore <backup-name>${C_RESET}"
        return
    fi
    restore_backup "$@"
}

cmd_install() {
    echo ""
    echo -e "  ${C_PURPLE}Kodra macOS Install${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""
    echo -e "  ${C_WHITE}What would you like to install?${C_RESET}"
    echo ""
    echo -e "  ${C_CYAN}1)${C_RESET} CLI tools (bat, eza, fzf, ripgrep, etc.)"
    echo -e "  ${C_CYAN}2)${C_RESET} Cloud tools (az, azd, terraform, kubectl, etc.)"
    echo -e "  ${C_CYAN}3)${C_RESET} Containers (colima/docker or podman)"
    echo -e "  ${C_CYAN}4)${C_RESET} Developer tools (mise, VS Code)"
    echo -e "  ${C_CYAN}5)${C_RESET} Terminal (ghostty, starship, nerd-fonts)"
    echo -e "  ${C_CYAN}6)${C_RESET} Everything"
    echo ""
    printf "  Choose [1-6]: "
    read -n 1 -r choice
    echo ""
    echo ""

    case "$choice" in
        1) for f in "$KODRA_DIR/install/cli-tools/"*.sh; do bash "$f"; done ;;
        2) for f in "$KODRA_DIR/install/cloud/"*.sh; do bash "$f"; done ;;
        3) for f in "$KODRA_DIR/install/containers/"*.sh; do bash "$f"; done ;;
        4) for f in "$KODRA_DIR/install/dev-tools/"*.sh; do bash "$f"; done ;;
        5) for f in "$KODRA_DIR/install/terminal/"*.sh; do bash "$f"; done ;;
        6) bash "$KODRA_DIR/install.sh" ;;
        *) echo -e "  ${C_GRAY}No selection made${C_RESET}" ;;
    esac
}

cmd_uninstall() {
    local tool="${1:-}"
    if [[ -z "$tool" ]]; then
        echo ""
        echo -e "  ${C_PURPLE}Kodra macOS Uninstall${C_RESET}"
        echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
        echo ""
        echo -e "  ${C_WHITE}Available tools to uninstall:${C_RESET}"
        echo ""
        for f in "$KODRA_DIR/uninstall/"*.sh; do
            local name
            name="$(basename "$f" .sh)"
            echo -e "    ${C_CYAN}•${C_RESET} $name"
        done
        echo ""
        echo -e "  ${C_GRAY}Usage: kodra uninstall <tool-name>${C_RESET}"
        echo -e "  ${C_GRAY}Example: kodra uninstall azure-cli${C_RESET}"
        return
    fi

    local script="$KODRA_DIR/uninstall/${tool}.sh"
    if [[ -f "$script" ]]; then
        bash "$script"
    else
        echo -e "  ${C_RED}✖${C_RESET} No uninstaller found for: $tool"
        echo -e "  ${C_GRAY}Run: kodra uninstall (with no args) to see available tools${C_RESET}"
        exit 1
    fi
}

cmd_migrate() {
    echo ""
    echo -e "  ${C_PURPLE}Kodra macOS Migrations${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""

    local migration_dir="$KODRA_DIR/migrations"
    if [[ ! -d "$migration_dir" ]] || [[ -z "$(ls -A "$migration_dir" 2>/dev/null)" ]]; then
        echo -e "  ${C_GREEN}✔${C_RESET} No migrations to run"
        return
    fi

    for migration in "$migration_dir"/*.sh; do
        local name
        name="$(basename "$migration" .sh)"
        local status
        status="$(bash "$migration" status 2>/dev/null || echo "unknown")"
        if [[ "$status" == "pending" ]]; then
            echo -e "  ${C_CYAN}▶${C_RESET} Running migration: $name"
            bash "$migration" up
        else
            echo -e "  ${C_GRAY}•${C_RESET} $name — already applied"
        fi
    done
    echo ""
}

cmd_welcome() {
    source "$KODRA_DIR/lib/ui.sh" 2>/dev/null || true
    if command -v show_banner &>/dev/null; then
        show_banner
    else
        show_help
    fi
}

cmd_resume() {
    source "$KODRA_DIR/lib/state.sh" 2>/dev/null || {
        echo -e "  ${C_RED}✖${C_RESET} Failed to load state library"
        exit 1
    }
    source "$KODRA_DIR/lib/utils.sh" 2>/dev/null || true

    echo ""
    echo -e "  ${C_PURPLE}Kodra macOS Resume${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""

    if ! can_resume; then
        echo -e "  ${C_GREEN}✔${C_RESET} Nothing to resume — no pending or failed steps"
        return 0
    fi

    show_state_summary

    local failed
    failed="$(get_failed_steps)"
    local pending
    pending="$(get_pending_steps)"

    if [[ -n "$failed" ]]; then
        echo ""
        echo -e "  ${C_RED}Failed steps:${C_RESET}"
        while IFS='|' read -r step status; do
            local msg="${status#failed:}"
            echo -e "    ${C_RED}✖${C_RESET} ${step} — ${msg}"
        done <<< "$failed"
    fi

    if [[ -n "$pending" ]]; then
        echo ""
        echo -e "  ${C_YELLOW}Pending steps:${C_RESET}"
        while IFS= read -r step; do
            echo -e "    ${C_YELLOW}○${C_RESET} ${step}"
        done <<< "$pending"
    fi

    echo ""
    echo -e "  ${C_CYAN}▶${C_RESET} Re-running failed and pending installers..."
    echo ""

    if [[ -n "$failed" ]]; then
        while IFS='|' read -r step _status; do
            local script="$KODRA_DIR/install/cli-tools/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/cloud/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/containers/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/terminal/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/dev-tools/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/desktop/${step}.sh"

            if [[ -f "$script" ]]; then
                echo -e "  ${C_CYAN}▶${C_RESET} Retrying: ${step}..."
                if bash "$script" 2>&1; then
                    mark_step_complete "$step"
                    echo -e "  ${C_GREEN}✔${C_RESET} ${step} succeeded"
                else
                    echo -e "  ${C_RED}✖${C_RESET} ${step} failed again"
                fi
            else
                echo -e "  ${C_YELLOW}⚠${C_RESET} No installer found for: ${step}"
            fi
        done <<< "$failed"
    fi

    if [[ -n "$pending" ]]; then
        while IFS= read -r step; do
            local script="$KODRA_DIR/install/cli-tools/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/cloud/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/containers/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/terminal/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/dev-tools/${step}.sh"
            [[ -f "$script" ]] || script="$KODRA_DIR/install/desktop/${step}.sh"

            if [[ -f "$script" ]]; then
                echo -e "  ${C_CYAN}▶${C_RESET} Running: ${step}..."
                if bash "$script" 2>&1; then
                    mark_step_complete "$step"
                    echo -e "  ${C_GREEN}✔${C_RESET} ${step} succeeded"
                else
                    mark_step_failed "$step" "install failed"
                    echo -e "  ${C_RED}✖${C_RESET} ${step} failed"
                fi
            else
                echo -e "  ${C_YELLOW}⚠${C_RESET} No installer found for: ${step}"
            fi
        done <<< "$pending"
    fi

    echo ""
    echo -e "  ${C_GRAY}Progress: $(get_install_progress)% complete${C_RESET}"
    echo ""
}

cmd_motd() {
    local C_LOGO_1='\033[38;5;135m'
    local C_LOGO_2='\033[38;5;141m'
    local C_LOGO_3='\033[38;5;147m'
    local C_LOGO_4='\033[38;5;117m'
    local C_LOGO_5='\033[38;5;87m'
    local C_DIM='\033[2m'
    local C_BOLD='\033[1m'

    local ver
    ver="$(show_version)"

    echo ""
    echo -e "${C_DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "${C_LOGO_1}  ██╗  ██╗ ██████╗ ██████╗ ██████╗  █████╗${C_RESET}"
    echo -e "${C_LOGO_2}  ██║ ██╔╝██╔═══██╗██╔══██╗██╔══██╗██╔══██╗${C_RESET}"
    echo -e "${C_LOGO_3}  █████╔╝ ██║   ██║██║  ██║██████╔╝███████║${C_RESET}"
    echo -e "${C_LOGO_4}  ██╔═██╗ ██║   ██║██║  ██║██╔══██╗██╔══██║${C_RESET}"
    echo -e "${C_LOGO_5}  ██║  ██╗╚██████╔╝██████╔╝██║  ██║██║  ██║${C_RESET}"
    echo -e "${C_LOGO_5}  ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝${C_RESET}"
    echo ""
    echo -e "  ${C_BOLD}v${ver}${C_RESET} ${C_DIM}•${C_RESET} macOS Edition ${C_DIM}•${C_RESET} by Code To Cloud"
    echo -e "${C_DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""

    if command -v fastfetch &>/dev/null; then
        fastfetch
    else
        echo -e "  ${C_GRAY}(install fastfetch for system info)${C_RESET}"
        echo ""
    fi
}

cmd_database() {
    local state_file="${KODRA_STATE_DIR:-$HOME/.local/state/kodra}/state.json"

    echo ""
    echo -e "  ${C_PURPLE}Kodra State Database${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""

    if [[ ! -f "$state_file" ]]; then
        echo -e "  ${C_GRAY}No state file found at: ${state_file}${C_RESET}"
        return 0
    fi

    echo -e "  ${C_GRAY}File: ${state_file}${C_RESET}"
    echo ""

    python3 -c "
import json
with open('${state_file}', 'r') as f:
    data = json.load(f)
print(json.dumps(data, indent=2, sort_keys=True))
" 2>/dev/null | while IFS= read -r line; do
        echo "  $line"
    done

    echo ""
}

cmd_ci_report() {
    echo ""
    echo -e "  ${C_PURPLE}Kodra CI Status${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""

    if ! command -v gh &>/dev/null; then
        echo -e "  ${C_RED}✖${C_RESET} GitHub CLI (gh) not installed"
        echo -e "  ${C_GRAY}Run: kodra doctor --fix${C_RESET}"
        return 1
    fi

    if ! gh auth status &>/dev/null 2>&1; then
        echo -e "  ${C_YELLOW}⚠${C_RESET} Not authenticated — run: gh auth login"
        return 1
    fi

    local repo
    repo="$(cd "$KODRA_DIR" && git remote get-url origin 2>/dev/null | sed 's|.*github.com[:/]||;s|\.git$||')"

    if [[ -z "$repo" ]]; then
        echo -e "  ${C_YELLOW}⚠${C_RESET} Could not determine repository"
        return 1
    fi

    echo -e "  ${C_GRAY}Repository: ${repo}${C_RESET}"
    echo ""

    gh run list --repo "$repo" --limit 10 2>/dev/null | while IFS= read -r line; do
        echo "  $line"
    done

    echo ""
}

cmd_menu() {
    echo ""
    echo -e "  ${C_PURPLE}Kodra macOS Menu${C_RESET}"
    echo -e "  ${C_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo ""
    echo -e "  ${C_CYAN}1)${C_RESET} Doctor — check system health"
    echo -e "  ${C_CYAN}2)${C_RESET} Update — update all tools"
    echo -e "  ${C_CYAN}3)${C_RESET} Install — install tool categories"
    echo -e "  ${C_CYAN}4)${C_RESET} Uninstall — remove a tool"
    echo -e "  ${C_CYAN}5)${C_RESET} Repair — fix issues"
    echo -e "  ${C_CYAN}6)${C_RESET} Backup — backup configs"
    echo -e "  ${C_CYAN}7)${C_RESET} Setup — configure accounts"
    echo -e "  ${C_CYAN}8)${C_RESET} Fetch — system info"
    echo -e "  ${C_CYAN}9)${C_RESET} Defaults — re-apply macOS settings"
    echo -e "  ${C_CYAN}0)${C_RESET} Exit"
    echo ""
    printf "  Choose [0-9]: "
    read -n 1 -r choice
    echo ""
    echo ""

    case "$choice" in
        1) cmd_doctor ;;
        2) cmd_update ;;
        3) cmd_install ;;
        4) cmd_uninstall ;;
        5) cmd_repair ;;
        6) cmd_backup ;;
        7) cmd_setup ;;
        8) cmd_fetch ;;
        9) cmd_defaults ;;
        0) echo -e "  ${C_GRAY}Bye!${C_RESET}" ;;
        *) echo -e "  ${C_GRAY}Invalid choice${C_RESET}" ;;
    esac
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Command router
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
case "${1:-help}" in
    doctor)     cmd_doctor "$2" ;;
    update)     cmd_update ;;
    cleanup)    cmd_cleanup ;;
    repair|fix) cmd_repair "$2" ;;
    setup)      cmd_setup ;;
    install)    cmd_install ;;
    uninstall|remove)  cmd_uninstall "$2" ;;
    dev)        cmd_dev ;;
    extensions) cmd_extensions ;;
    fetch)      cmd_fetch ;;
    defaults)   cmd_defaults ;;
    refresh)    cmd_refresh ;;
    shortcuts|alias|aliases)  cmd_shortcuts ;;
    backup)     cmd_backup "$2" "$3" ;;
    restore)    cmd_restore "$2" ;;
    migrate)    cmd_migrate ;;
    resume)     cmd_resume ;;
    motd|banner) cmd_motd ;;
    db|database) cmd_database ;;
    ci-report|ci) cmd_ci_report ;;
    menu)       cmd_menu ;;
    welcome)    cmd_welcome ;;
    version)    show_version ;;
    help|--help|-h) show_help ;;
    *)
        echo -e "  ${C_RED}Unknown command:${C_RESET} $1"
        echo -e "  ${C_GRAY}Run: kodra help${C_RESET}"
        exit 1
        ;;
esac
